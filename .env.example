# SmartGovAI-2026 Environment Configuration
# Copy to .env and fill in real values before running.

# ── Required ──────────────────────────────────────────────
SECRET_KEY=                # Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=               # Bearer token for /analytics — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Optional (defaults shown) ────────────────────────────
GEMINI_API_KEY=            # Enables AI PDF simplification and dynamic chat responses (app runs without it in catalog-only mode)
DEBUG_MODE=0               # Set to 1 for Flask debug mode (never in production)
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DB_PATH=                   # Defaults to ./feedback.db
MAX_PDF_PAGES=50           # Reject PDFs with more pages than this
TRUSTED_PROXIES=0          # Number of upstream reverse proxies (e.g. 1 if behind Nginx/Cloudflare)

# ── Rate Limiting ────────────────────────────────────────
REDIS_URL=                 # e.g. redis://localhost:6379/0 — falls back to in-memory if unset
RATELIMIT_DEFAULT=200 per day; 50 per hour
RATELIMIT_SIMPLIFY=10 per minute; 60 per hour
RATELIMIT_FEEDBACK=20 per minute
RATELIMIT_REPORT=10 per minute
RATELIMIT_CHAT=15 per minute; 100 per hour