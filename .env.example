# SmartGovAI-2026 Environment Configuration
# Copy to .env and fill in real values before running.

# ── Required ──────────────────────────────────────────────
# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Bearer token for /analytics — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── Optional (defaults shown) ────────────────────────────
# Leave blank to run in catalog-only mode.
GEMINI_API_KEY=
# Optionally override the default configured in config.py.
# GEMINI_MODEL_NAME=gemini-3.5-flash
DEBUG_MODE=0
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
# Defaults to ./feedback.db
DB_PATH=
MAX_PDF_PAGES=50
MAX_EXTRACTED_CHARS=50000
# Set the number of trusted upstream reverse proxies.
TRUSTED_PROXIES=0
# Set to 1 when serving through HTTPS; leave 0 for local HTTP.
SESSION_COOKIE_SECURE=0

# ── Rate Limiting ────────────────────────────────────────
# e.g. redis://localhost:6379/0 — falls back to in-memory if unset
REDIS_URL=
RATELIMIT_DEFAULT=200 per day; 50 per hour
RATELIMIT_SIMPLIFY=10 per minute; 60 per hour
RATELIMIT_FEEDBACK=20 per minute
RATELIMIT_REPORT=10 per minute
RATELIMIT_CHAT=15 per minute; 100 per hour
